def computer_pid_log():
    """(pid_file, log_file) from config.yaml, with safe defaults.

    Local artifacts live inside the file_organizer folder, never in the
    user's home directory.
    """
    _insert_src_path()
    from file_organizer.config import Config, resolve_log_path
    pid_file = "/tmp/file_organizer.pid"
    log_file = str(HERE / ".file_organizer.log")
    try:
        cfg = Config(str(computer_config_path()))
        pid_file = cfg.data.get("pid_path") or pid_file
        log_file = resolve_log_path(str(computer_config_path()))
    except Exception:
        pass
    return os.path.expanduser(pid_file), os.path.expanduser(log_file)


def phone_pid_log():
    """(pid_file, log_file) from the phone config, with safe defaults.

    Local artifacts live inside the file_organizer folder, never in the
    user's home directory.
    """
    _insert_src_path()
    from file_organizer import phone_sync
    pid_file = str(HERE / ".phone_sync.pid")
    log_file = str(HERE / ".phone_sync.log")
