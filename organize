        return Path.home() / "organized"


def computer_clean(log):
    """Wipe the organized folder, log, and progress — then a fresh
    production scan. Local artifacts live inside the file_organizer folder.
    """
    import shutil
    for path in (
        computer_output_base(),
        computer_pid_log()[1],
        HERE / ".file_organizer_progress.json",
        HERE / ".file_organizer_discovered_categories.json",
        # Legacy locations from before local files moved into this folder.
        Path.home() / ".file_organizer_progress.json",
        Path.home() / ".file_organizer_discovered_categories.json",
    ):
        try:
            if os.path.isdir(path):
                shutil.rmtree(path)
            elif os.path.exists(path):
                os.remove(path)
        except OSError:
            pass
    log("Cleaned. Starting fresh production scan...")
    run_computer_cli(COMPUTER_COMMANDS["test-real"])


def computer_pull_push_list(log, argv):
    """ADB phone sync — delegate to src/phone_pull.sh.

    argv[0] is the organize subcommand (pull/push/list); it becomes the
    matching phone_pull.sh flag (pull is the script's default mode) and
    the remaining args (--dry-run, --device X, -v) pass straight through.
    """
    script = SRC / "phone_pull.sh"
    if not script.exists():
        log(f"Phone sync tool not found: {script}")
        raise SystemExit(1)
    subprocess.run(["bash", str(script)] + adb_argv(argv))


def adb_argv(argv):
    """phone_pull.sh argv for an organize ADB subcommand (pull/push/list).

    The leading subcommand maps to phone_pull.sh's own flag; the rest of
    the args pass straight through.
    """
    flags = ADB_MODE_FLAGS.get(argv[0], [])
    return flags + list(argv[1:])


# ── GUI interpreter ─────────────────────────────────────────────────────────
# Apple's bundled /usr/bin/python3 ships Tk 8.5 (2010-era Aqua Tk), which
# draws an empty black window and burns CPU on modern macOS. The desktop
# GUI needs an interpreter whose Tk is 8.6 or newer (Homebrew's
# python-tk@3.x ships 8.6/9.0). desktop_app.py re-checks when run directly;
# this just picks the best interpreter to launch it with.

GUI_PYTHON_CANDIDATES = (
    "python3.14", "python3.13", "python3.12", "python3.11", "python3.10",
)

GUI_TK_CHECK = "import tkinter,sys;sys.exit(0 if tkinter.TkVersion>=8.6 else 1)"


def tk_is_modern(exe):
    """True if `exe` can import tkinter with Tk 8.6 or newer."""
    try:
        proc = subprocess.run(
            [exe, "-c", GUI_TK_CHECK], capture_output=True, timeout=20
        )
        return proc.returncode == 0
    except Exception:
        return False


def gui_python():
    """Best interpreter for the desktop GUI, or None if none has Tk 8.6+.

    None means even the current interpreter is too old — the caller
    prints install instructions instead of opening a black window.
    """
    if tk_is_modern(sys.executable):
        return sys.executable
    for name in GUI_PYTHON_CANDIDATES:
        exe = shutil.which(name)
        if exe and exe != sys.executable and tk_is_modern(exe):
            return exe
    return None


def computer_gui(log):
    app = PACKAGE / "desktop_app.py"
    exe = gui_python()
    if exe is None:
        log(
            "\nNo Python with Tk 8.6+ found — this computer's python3 has "
            "Tk 8.5,\nwhich draws an empty black window on modern macOS.\n"
            "\n"
            "Fix it with Homebrew, then run this again:\n"
            "  brew install python-tk@3.14\n"
            "\n"
            "('./organize gui' picks up python3.10+ with a modern Tk\n"
            "automatically once one is installed.)\n"
        )
        return 1
    if exe != sys.executable:
        log(f"(using {exe} — this python3's Tk is too old to draw the window)")
    subprocess.run([exe, str(app)])
    return 0


# ── Web interpreter ─────────────────────────────────────────────────────────
# Apple's bundled /usr/bin/python3 doesn't ship flask, so './organize web'
# must pick a python3 that has it (Homebrew's python3.14 on this machine).
# web_app.py imports flask at the top, so launching with a flask-less
# interpreter dies with a traceback before anything useful is printed.

WEB_FLASK_CHECK = "import flask"


def flask_available(exe):
    """True if `exe` can import flask."""
    try:
        proc = subprocess.run(
            [exe, "-c", WEB_FLASK_CHECK], capture_output=True, timeout=20
        )
        return proc.returncode == 0
    except Exception:
        return False


def web_python():
    """Best interpreter for the web UI, or None if none has flask.

    None means even the current interpreter lacks flask — the caller
    prints install instructions instead of a traceback.
    """
    if flask_available(sys.executable):
        return sys.executable
    for name in GUI_PYTHON_CANDIDATES:
        exe = shutil.which(name)
        if exe and exe != sys.executable and flask_available(exe):
            return exe
    return None


def computer_web(log):
    app = PACKAGE / "web_app.py"
    exe = web_python()
    if exe is None:
        log(
            "\nNo Python with flask found — the web UI needs it.\n"
            "\n"
            "Fix it, then run this again:\n"
            "  brew install python@3.14 && python3.14 -m pip install flask\n"
            "\n"
            "('./organize web' picks up python3.10+ with flask\n"
            "automatically once one is installed.)\n"
        )
        return 1
    if exe != sys.executable:
        log(f"(using {exe} — this python3 has no flask)")
    subprocess.run([exe, str(app)])
    return 0


