# ── main ───────────────────────────────────────────────────────────────────

def main(argv=None):
    argv = list(sys.argv[1:]) if argv is None else list(argv)
    platform = detect_platform(argv)
    _, argv = split_platform_args(argv)

    if not argv or argv[0] in ("help", "-h", "--help"):
        sys.stdout.write(usage(platform))
        return 0

    mapped, handled = map_command(platform, argv)
    log = lambda msg: print(msg, flush=True)

    # ── lifecycle commands handled by organize itself ──
    if handled == "start":
        (computer_start if platform == "computer" else phone_start)(log)
        return 0
    if handled == "stop":
        (computer_stop if platform == "computer" else phone_stop)(log)
        return 0
    if handled == "restart":
        (computer_stop if platform == "computer" else phone_stop)(log)
        time.sleep(2)
        (computer_start if platform == "computer" else phone_start)(log)
        return 0
    if handled == "status":
        (computer_status if platform == "computer" else phone_status)(log)
        return 0
    if handled == "log":
        path = (computer_pid_log if platform == "computer" else phone_pid_log)()[1]
        tail_log(path, log)
        return 0
    if handled == "setup":
        (computer_setup if platform == "computer" else phone_setup)(log)
        return 0
    if handled == "clean":
        computer_clean(log)
        return 0
    if handled == "gui":
        computer_gui(log)
        return 0
    if handled == "web":
        computer_web(log)
        return 0
    if handled in ("pull", "push", "list"):
        computer_pull_push_list(log, mapped)
        return 0

    # ── plain CLI passthrough ──
    if platform == "computer":
        run_computer_cli(mapped)
    else:
        run_phone_cli(mapped)
    return 0


if __name__ == "__main__":
    sys.exit(main())
