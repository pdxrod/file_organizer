# ── main ───────────────────────────────────────────────────────────────────

def main(argv=None):
    argv = list(sys.argv[1:]) if argv is None else list(argv)
    platform = detect_platform(argv)
    _, argv = split_platform_args(argv)

    if not argv:
        # Plain `./organize` with no subcommand: normally the usage text.
        # On a computer whose config.yaml is missing or invalid, open the
        # guided config editor instead (help/--help still prints usage).
        if bare_run_action(platform) == "config":
            sys.stderr.write(
                "\nconfig.yaml is missing or invalid, so let's fix that "
                "first —\nopening the guided config editor instead of the "
                "command list.\n(Run './organize help' for the commands any "
                "time.)\n"
            )
            return computer_config_edit()
        sys.stdout.write(usage(platform))
        return 0

    if argv[0].lstrip("-").lower() in ("help", "h"):
        sys.stdout.write(usage(platform))
        return 0

    if argv[0].lstrip("-").lower() == "version":
        _insert_src_path()
        try:
            from file_organizer import __version__
        except ImportError:
            __version__ = "unknown"
        sys.stdout.write(f"organize {__version__}\n")
        return 0

    mapped, handled = map_command(platform, argv)
    log = lambda msg: print(msg, flush=True)

    # Phone-only subcommand used on this computer: explain it and stop.
    if handled and handled.startswith("phone-only-"):
        sys.stderr.write(phone_only_message(handled[len("phone-only-"):]))
        return 1

    # Computer-only subcommand used on a phone: explain it and stop.
    if handled and handled.startswith("computer-only-"):
        sys.stderr.write(computer_only_message(handled[len("computer-only-"):]))
        return 1

    # ── lifecycle commands handled by organize itself ──
    if handled == "config":
        return computer_config_edit()
    if handled == "start":
        (computer_start if platform == "computer" else phone_start)(log)
        return 0
    if handled == "stop":
        (computer_stop if platform == "computer" else phone_stop)(log)
        return 0
    if handled == "restart":
        (computer_stop if platform == "computer" else phone_stop)(log)
        time.sleep(2)
        (computer_start if platform == "computer" else phone_start)(log)
        return 0
    if handled == "status":
        (computer_status if platform == "computer" else phone_status)(log)
        return 0
    if handled == "log":
        path = (computer_pid_log if platform == "computer" else phone_pid_log)()[1]
        tail_log(path, log)
        return 0
    if handled == "setup":
        (computer_setup if platform == "computer" else phone_setup)(log)
        return 0
    if handled == "clean":
        computer_clean(log)
        return 0
    if handled == "gui":
        return computer_gui(log)
    if handled == "web":
        computer_web(log)
        return 0
    if handled in ("pull", "push", "list"):
        computer_pull_push_list(log, mapped)
        return 0

    # ── plain CLI passthrough ──
    if platform == "computer":
        run_computer_cli(mapped)
    else:
        run_phone_cli(mapped)
    return 0


if __name__ == "__main__":
    sys.exit(main())
