# ── wrong-device subcommands ─────────────────────────────────────────────
# Every subcommand that exists on only ONE device, computed from the
# command tables above so the lists can never drift out of sync.
# map_command explains them ("only works on the phone/computer") instead
# of leaking the local CLI's 'unrecognized arguments' error.
# (`scan-once` is deliberately NOT phone-only — it is also a valid
# computer flag.)
COMPUTER_LIFECYCLE = ("start", "stop", "restart", "status", "log", "clean",
                     "gui", "web", "pull", "push", "list", "setup")
PHONE_LIFECYCLE = ("start", "stop", "restart", "status", "log", "setup")

# Exists only on the computer — a phone running it gets an explanation.
COMPUTER_ONLY_COMMANDS = frozenset(
    set(COMPUTER_COMMANDS) - set(PHONE_COMMANDS)
) | (
    frozenset(COMPUTER_LIFECYCLE)
    - frozenset(PHONE_COMMANDS)
    - frozenset(PHONE_LIFECYCLE)
) | {"config"}

# Exists only on the phone — a computer running it gets an explanation.
PHONE_ONLY_COMMANDS = frozenset(
    (set(PHONE_COMMANDS) - set(COMPUTER_COMMANDS) - set(COMPUTER_LIFECYCLE))
    | (set(PHONE_LIFECYCLE) - set(COMPUTER_LIFECYCLE))
) - {"scan-once"}

# Phone flags that pass straight through to phone_sync.
PHONE_PASSTHROUGH = (
    "--scan-once", "--dry-run", "--background", "--daemon",
    "--find-cloud-drives", "--stats", "--status",
    "--stop", "--make-config", "--rename-held",
    "-v", "--verbose", "--config", "-h", "--help",
)

# organize ADB subcommand → phone_pull.sh flag (pull is its default mode).
ADB_MODE_FLAGS = {"pull": [], "push": ["--push"], "list": ["--list"]}


def normalize_flag(token, known):
    """One flag/subcommand token → its canonical spelling.

    Case-insensitive and dash-optional: auto, -auto, Auto, AUTO, --auto
    and -AUTO all resolve to 'auto'. Tokens that match nothing in `known`
    pass through untouched (they are values, e.g. a file name after
    `config`).
    """
    name = token.lstrip("-").lower()
    for canon in known:
        if canon.lstrip("-").lower() == name:
            return canon
    return token


def map_command(platform, argv):
    """Map a leading subcommand to CLI args for the platform CLI.

    Returns (argv_for_cli, handled_here) where handled_here is the name of
    a lifecycle subcommand (start/stop/restart/status/log/gui/…) that
    organize itself implements, or None.
    """
    if not argv:
        return argv, None
    passthrough = (COMPUTER_PASSTHROUGH if platform == "computer"
                   else PHONE_PASSTHROUGH)
    commands = COMPUTER_COMMANDS if platform == "computer" else PHONE_COMMANDS
    lifecycle = COMPUTER_LIFECYCLE if platform == "computer" else PHONE_LIFECYCLE
    head, rest = argv[0], argv[1:]
    key = normalize_flag(head, list(commands) + list(lifecycle))
    if key in commands:
        mapped_rest = [normalize_flag(a, passthrough) for a in rest]
        return commands[key] + mapped_rest, None
    if key in lifecycle:
        mapped_rest = [normalize_flag(a, passthrough) for a in rest]
        return [key] + mapped_rest, key
    if platform == "computer" and key.lstrip("-").lower() in PHONE_ONLY_COMMANDS:
        # A phone-only subcommand on a computer (rename, stats,
        # make-config, …) must be explained in main(), never passed to
        # the computer CLI. Compare case/dash-insensitively — unknown
        # tokens keep their original spelling here.
        return rest, f"phone-only-{key.lstrip('-').lower()}"
    if (platform == "computer" and not head.startswith("-")
            and key.lstrip("-").lower() == "config"):
        # `organize config` — the guided section-by-section editor that
        # organize itself implements. The DASHED form `--config FILE`
        # keeps its old meaning (pass a config path through to the CLI).
        mapped_rest = [normalize_flag(a, passthrough) for a in rest]
        return [key] + mapped_rest, "config"
    phone_key = key.lstrip("-").lower()
    if (platform == "phone" and phone_key in COMPUTER_ONLY_COMMANDS
            and not (phone_key == "config" and head.startswith("-"))):
        # A computer-only subcommand on a phone (test-real, route, sync,
        # config, …) must be explained in main(), never passed to the
        # phone CLI. (`--config FILE` stays a phone passthrough flag.)
        return rest, f"computer-only-{phone_key}"
    # Plain passthrough: normalize every known flag in argv.
    return [normalize_flag(a, passthrough) for a in argv], None


